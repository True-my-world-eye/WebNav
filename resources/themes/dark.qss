/* ============================================================
 * dark.qss — WebNav 深色主题
 * ============================================================ */

/* ── 全局 ── */
QMainWindow, QDialog, QWidget {
    background-color: #1c1c1e;
    color: #f5f5f7;
    font-family: -apple-system, "Segoe UI", "Microsoft YaHei", sans-serif;
}
QMainWindow::separator {
    background: #38383a;
    width: 1px;
}

/* ── 菜单栏 ── */
QMenuBar {
    background: #2c2c2e;
    border-bottom: 1px solid #38383a;
    padding: 2px;
    color: #f5f5f7;
}
QMenuBar::item:selected { background: #48484a; }
QMenu {
    background: #2c2c2e;
    border: 1px solid #38383a;
    padding: 4px;
    color: #f5f5f7;
}
QMenu::item:selected { background: #48484a; }

/* ── 工具栏 ── */
QToolBar {
    background: #2c2c2e;
    border-bottom: 1px solid #38383a;
    spacing: 6px;
    padding: 2px 6px;
}
QToolBar QPushButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 4px 10px;
    color: #f5f5f7;
}
QToolBar QPushButton:hover {
    background: #48484a;
    border-color: #38383a;
}
QToolBar QPushButton:pressed {
    background: #636366;
}

/* ── 搜索栏 ── */
#searchBar {
    background: #2c2c2e;
    border: 1px solid #48484a;
    border-radius: 6px;
    padding: 4px 10px;
    font-size: 13px;
    min-height: 22px;
    color: #f5f5f7;
}
#searchBar:focus {
    border-color: #0a84ff;
}

/* ── 侧边栏 ── */
#sidebar {
    background: #2c2c2e;
    border-right: 1px solid #38383a;
}
#sectionTitle {
    font-size: 12px;
    font-weight: 600;
    color: #98989d;
    padding: 6px 4px 2px 4px;
}
#sidebarAddBtn {
    background: #3a3a3c;
    border: 1px solid #48484a;
    border-radius: 4px;
    padding: 0px;
    font-size: 14px;
    font-weight: 600;
    color: #f5f5f7;
    min-width: 20px;
    min-height: 20px;
    max-width: 20px;
    max-height: 20px;
}
#sidebarAddBtn:hover {
    background: #48484a;
}
#sidebarAddBtn:pressed {
    background: #636366;
}

/* ── 文件夹树 ── */
QTreeWidget {
    background: transparent;
    border: none;
    font-size: 13px;
    color: #f5f5f7;
    outline: none;
}
QTreeWidget::item {
    padding: 4px 6px;
    border-radius: 4px;
    margin: 1px 0;
    color: #f5f5f7;
}
QTreeWidget::item:selected {
    background: #48484a;
    color: #ffffff;
}
QTreeWidget::item:hover:!selected {
    background: #3a3a3c;
}

/* ── 标签列表 ── */
#tagList {
    background: transparent;
    border: none;
    font-size: 13px;
    color: #f5f5f7;
    outline: none;
}
#tagList::item {
    padding: 4px 6px;
    border-radius: 4px;
    margin: 1px 0;
    color: #f5f5f7;
}
#tagList::item:selected {
    background: #48484a;
}
#tagList::item:hover:!selected {
    background: #3a3a3c;
}

/* ── 表格视图 ── */
QTableView {
    background: #1c1c1e;
    alternate-background-color: #252527;
    border: 1px solid #38383a;
    border-radius: 6px;
    font-size: 13px;
    gridline-color: #333336;
    color: #f5f5f7;
}
QTableView::item {
    padding: 6px 8px;
    border-bottom: 1px solid #2c2c2e;
    color: #f5f5f7;
}
QTableView::item:selected {
    background: #3a3a3c;
    color: #ffffff;
    border: none;
}
QHeaderView::section {
    background: #2c2c2e;
    color: #f5f5f7;
    padding: 6px 8px;
    border: none;
    border-bottom: 1px solid #38383a;
    border-right: 1px solid #38383a;
    font-weight: 600;
    font-size: 12px;
}
QHeaderView::section:hover {
    background: #48484a;
}

/* ── 按钮 ── */
QPushButton {
    background: #3a3a3c;
    border: 1px solid #48484a;
    border-radius: 6px;
    padding: 6px 16px;
    font-size: 13px;
    color: #f5f5f7;
}
QPushButton:hover {
    background: #48484a;
}
QPushButton:pressed {
    background: #636366;
}
QPushButton:default {
    background: #0a84ff;
    color: #ffffff;
    border-color: #0a84ff;
}
QPushButton:default:hover {
    background: #0071e3;
}

/* ── 输入框 ── */
QLineEdit {
    background: #2c2c2e;
    border: 1px solid #48484a;
    border-radius: 6px;
    padding: 4px 8px;
    font-size: 13px;
    min-height: 22px;
    color: #f5f5f7;
}
QLineEdit:focus {
    border-color: #0a84ff;
}

/* ── 下拉框 ── */
QComboBox {
    background: #2c2c2e;
    border: 1px solid #48484a;
    border-radius: 6px;
    padding: 4px 8px;
    font-size: 13px;
    min-height: 22px;
    color: #f5f5f7;
}
QComboBox:focus {
    border-color: #0a84ff;
}
QComboBox::drop-down {
    border: none;
    width: 24px;
}
QComboBox QAbstractItemView {
    background: #2c2c2e;
    border: 1px solid #38383a;
    color: #f5f5f7;
    selection-background-color: #48484a;
}

/* ── 文本框 ── */
QTextEdit {
    background: #2c2c2e;
    border: 1px solid #48484a;
    border-radius: 6px;
    padding: 4px 6px;
    font-size: 13px;
    color: #f5f5f7;
}

/* ── 分组框 ── */
QGroupBox {
    font-weight: 600;
    font-size: 13px;
    color: #f5f5f7;
    border: 1px solid #38383a;
    border-radius: 8px;
    margin-top: 8px;
    padding: 16px 12px 12px 12px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    padding: 0 6px;
    color: #f5f5f7;
}

/* ── 拆分器 ── */
QSplitter::handle {
    background: #38383a;
    width: 2px;
}

/* ── 状态栏 ── */
QStatusBar {
    background: #2c2c2e;
    border-top: 1px solid #38383a;
    font-size: 12px;
    color: #98989d;
}

/* ── 滚动条 ── */
QScrollBar:vertical {
    background: #1c1c1e;
    width: 8px;
    border: none;
    border-radius: 4px;
}
QScrollBar::handle:vertical {
    background: #48484a;
    border-radius: 4px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover { background: #636366; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }

QScrollBar:horizontal {
    background: #1c1c1e;
    height: 8px;
    border: none;
    border-radius: 4px;
}
QScrollBar::handle:horizontal {
    background: #48484a;
    border-radius: 4px;
    min-width: 30px;
}
QScrollBar::handle:horizontal:hover { background: #636366; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
